PORT=3000
NODE_ENV=development
API_BIND_ADDRESS=0.0.0.0
AES_SECRET_KEY=replace_with_a_random_64_character_hex_key
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_minimum_12_characters
DATABASE_URL=postgresql://banostour:replace_with_database_password@localhost:5432/banostour
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
ENABLE_SWAGGER=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=15
POSTGRES_PORT=5432
PGADMIN_PORT=5051
POSTGRES_USER=banostour
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=banostour
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_strong_pgadmin_password

# Firebase Cloud Messaging. Déjalas vacías hasta configurar notificaciones push.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Correo transaccional opcional para recuperación de contraseña.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
