POSTGRES_DB=banostour
POSTGRES_USER=banostour_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://banostour_user:replace_with_local_password@localhost:5433/banostour

PGADMIN_EMAIL=admin@banostour.local
PGADMIN_PASSWORD=replace_with_local_password
PGADMIN_PORT=5050

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@banostour.local
ADMIN_PASSWORD=replace_with_a_unique_admin_password
ADMIN_NAME=Administrador Maestro
CACHE_TTL_SECONDS=60
PORT=3000
NODE_ENV=development
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:5173,http://192.168.1.18:5173,http://localhost,capacitor://localhost

# Recuperación de contraseña por correo
PASSWORD_RESET_URL=http://localhost:5173/reset-password
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=correo@example.com
MAIL_PASSWORD=replace_with_smtp_password
MAIL_FROM=BañosTour <correo@example.com>
